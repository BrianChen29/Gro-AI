# Local development environment template.
# Copy this file to backend/.env and fill in local-only values.
#
# Do not commit real API keys, production database credentials, or JWT secrets.

# Database
DATABASE_URL=mysql+asyncmy://chatuser:chatpass@127.0.0.1:3306/groceryshopperai

# Auth
JWT_SECRET=replace-with-a-long-random-dev-secret
JWT_EXPIRE_MINUTES=43200

# App
APP_HOST=0.0.0.0
APP_PORT=8000
GROCERY_CSV_PATH=./GroceryDataset.csv

# LLM providers
LLM_MODEL=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Catalog vector retrieval. Use "memory" for the existing SQLite-backed exact
# search, or "pinecone" for the managed async backend.
VECTOR_STORE_BACKEND=memory
EMBEDDINGS_DB_PATH=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=catalog
PINECONE_BATCH_SIZE=50
